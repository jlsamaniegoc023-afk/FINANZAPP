# FINANZAPP - Plantilla de variables de entorno

# Google Gemini
GEMINI_API_KEY=REEMPLAZAR_CON_TU_API_KEY

# Aplicacion
APP_URL=http://localhost:3000
PORT=3000

# Seguridad JWT: generar una clave aleatoria segura
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO

# Correo SMTP Gmail
GMAIL_USER=correo@example.com
GMAIL_APP_PASSWORD=REEMPLAZAR_CON_PASSWORD_DE_APLICACION

# PostgreSQL 16
PGDATABASE=finanzapp
PGUSER=finanzapp_user
PGPASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
